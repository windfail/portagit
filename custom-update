#!/bin/bash

set -euo pipefail

LIST=/tmp/portagit_list
ADDLIST=/tmp/portagit_addlist
MASTER_BRANCH=master
DEVBRANCH=yily
CONFDIR=/etc
BACKUP_DIR="$CONFDIR/custom_bak"

cleanup()
{
    if [[ -f "$LIST" ]]; then
        rm -f "$LIST"
    fi
    if [[ -f "$ADDLIST" ]]; then
        rm -f "$ADDLIST"
    fi
}

die()
{
    echo "error: $*" >&2
    cleanup
    exit 1
}

show_help()
{
    echo "Usage: $(basename "$0") [OPTION]"
    echo ""
    echo "Options:"
    echo "  -k          check ._cfg config files status"
    echo "  -u          update etc with ._cfg files and custom changes"
    echo "  -a <file>   manually add a ._cfg file to both branches"
    echo "  -h          show this help"
}

find_cfg_files()
{
    rm -f "$ADDLIST"
    WORKDIR=$(pwd)
    cd "$CONFDIR" || die "cannot cd to $CONFDIR"

    while IFS= read -r -d '' cfgfile; do
        PREFIX_DIR=$(dirname "$cfgfile")
        CFGNAME=$(basename "$cfgfile")
        FILE="${PREFIX_DIR:5}/${CFGNAME:10}"
        FILE="${FILE#/}"
        if [[ -z "$FILE" ]]; then
            continue
        fi
        echo "$FILE" >> "$ADDLIST"
        echo "  found: $FILE (from $CFGNAME)"
    done < <(find "$CONFDIR" -name '._cfg*' -print0)

    cd "$WORKDIR" || true

    if [[ ! -f "$ADDLIST" || ! -s "$ADDLIST" ]]; then
        echo "No ._cfg files found."
        return 1
    fi
    return 0
}

do_add()
{
    local cfgfile="$1"
    if [[ ! -f "$cfgfile" ]]; then
        die "file not found: $cfgfile"
    fi

    local cfgname
    cfgname=$(basename "$cfgfile")
    local prefix_dir
    prefix_dir=$(dirname "$cfgfile")
    local file="${prefix_dir:5}/${cfgname:10}"
    file="${file#/}"

    if [[ -z "$file" ]]; then
        die "cannot extract target filename from $cfgfile"
    fi

    cd "$CONFDIR" || die "cannot cd to $CONFDIR"

    cp "$cfgfile" "/tmp/${cfgname}.bak" || die "backup failed"

    git checkout "$MASTER_BRANCH" || die "cannot checkout $MASTER_BRANCH"
    cp "/tmp/${cfgname}.bak" "$file" || die "cannot copy to $file on $MASTER_BRANCH"
    git add -f "$file" || die "cannot add $file on $MASTER_BRANCH"
    git commit -m "add $file" || die "cannot commit on $MASTER_BRANCH"

    git checkout "$DEVBRANCH" || die "cannot checkout $DEVBRANCH"
    cp "/tmp/${cfgname}.bak" "$cfgfile" || die "cannot restore $cfgfile"
    git add -f "$file" || die "cannot add $file on $DEVBRANCH"
    git commit -m "modify $file" || die "cannot commit on $DEVBRANCH"

    rm -f "/tmp/${cfgname}.bak"
    echo "Added $file to both branches."
}

do_check()
{
    echo "Checking ._cfg files in $CONFDIR..."
    if find_cfg_files; then
        echo ""
        echo "Files needing update:"
        sort -u "$ADDLIST"
    fi
    cleanup
}

do_update()
{
    cd "$CONFDIR" || die "cannot cd to $CONFDIR"

    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "Committing uncommitted changes..."
        git add -A || die "git add failed"
        git commit -m "auto commit before merge" || die "git commit failed"
    fi

    if ! find_cfg_files; then
        echo "Nothing to update."
        cleanup
        return
    fi

    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$current_branch" != "$DEVBRANCH" ]]; then
        die "not on $DEVBRANCH branch (current: $current_branch)"
    fi

    mkdir -p "$BACKUP_DIR"
    while IFS= read -r name; do
        if [[ -f "$name" ]]; then
            mkdir -p "$BACKUP_DIR/$(dirname "$name")"
            cp "$name" "$BACKUP_DIR/$name" || die "backup failed for $name"
        fi
    done < "$ADDLIST"
    echo "User configs backed up to $BACKUP_DIR"

    while IFS= read -r name; do
        if [[ -f "$name" ]]; then
            git add -f "$name" || die "cannot add $name on $DEVBRANCH"
        fi
    done < "$ADDLIST"
    if ! git diff --cached --quiet; then
        git commit -m "save user modifications before merge" || die "commit failed on $DEVBRANCH"
    fi

    git checkout "$MASTER_BRANCH" || die "cannot checkout $MASTER_BRANCH"

    while IFS= read -r name; do
        if [[ -f "$name" ]]; then
            git checkout "$DEVBRANCH" -- "$name" || die "cannot checkout $name from $DEVBRANCH"
        fi
    done < "$ADDLIST"

    etc-update --automode -5 || die "etc-update failed"

    while IFS= read -r name; do
        git add -f "$name" || die "cannot add $name on $MASTER_BRANCH"
    done < "$ADDLIST"
    if ! git diff --cached --quiet; then
        git commit -m "update with new upstream configs" || die "commit failed on $MASTER_BRANCH"
    fi

    git checkout "$DEVBRANCH" || die "cannot checkout $DEVBRANCH"

    local merge_success=true
    if ! git merge --allow-unrelated-histories "$MASTER_BRANCH"; then
        merge_success=false
    fi

    if [[ -f /etc/sudoers ]] && [[ -f "$BACKUP_DIR/sudoers" ]] && ! visudo -cf /etc/sudoers; then
        echo ""
        echo "=========================================="
        echo "  WARNING: sudoers 语法错误！自动恢复备份"
        echo "=========================================="
        cp "$BACKUP_DIR/sudoers" /etc/sudoers
        echo "已从备份恢复 /etc/sudoers"
        echo "上游新版本保存在: $BACKUP_DIR/sudoers"
        echo ""
        echo "请手动对比合并后执行:"
        echo "  visudo  # 编辑确认语法正确"
        merge_success=false
    fi

    for sdf in /etc/sudoers.d/*; do
        local sdf_name="${sdf#/etc/}"
        if [[ -f "$sdf" ]] && [[ -f "$BACKUP_DIR/$sdf_name" ]] && ! visudo -cf "$sdf"; then
            echo ""
            echo "=========================================="
            echo "  WARNING: $sdf_name 语法错误！自动恢复备份"
            echo "=========================================="
            cp "$BACKUP_DIR/$sdf_name" "$sdf"
            echo "已从备份恢复 $sdf"
            echo "上游新版本保存在: $BACKUP_DIR/$sdf_name"
            merge_success=false
        fi
    done

    if $merge_success; then
        echo "Merge completed successfully."
    else
        echo ""
        echo "=========================================="
        echo "  Merge conflicts detected!"
        echo "  Please resolve conflicts in the files"
        echo "  listed above, then run:"
        echo ""
        echo "    git add -A"
        echo "    git commit"
        echo ""
        echo "  Your original configs are backed up in:"
        echo "    $BACKUP_DIR"
        echo "=========================================="
        cleanup
        return
    fi

    while IFS= read -r name; do
        local cfg_prefix_dir
        cfg_prefix_dir=$(dirname "$name")
        for cfg in "$CONFDIR/$cfg_prefix_dir"/._cfg*; do
            [[ -f "$cfg" ]] && rm -f "$cfg" && echo "Cleaned up $(basename "$cfg")"
        done
    done < "$ADDLIST"

    echo ""
    echo "Update complete. ._cfg files cleaned up."
    cleanup
}

cleanup

case "${1:-}" in
    "-a" )
        [[ -z "${2:-}" ]] && die "usage: $(basename "$0") -a <._cfg_file>"
        do_add "$2"
        ;;
    "-k" )
        do_check
        ;;
    "-u" )
        do_update
        ;;
    "-h"|"--help" )
        show_help
        ;;
    * )
        show_help
        exit 1
        ;;
esac
